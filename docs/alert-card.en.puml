@startuml alert-card-en
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 13
skinparam PackageBorderColor #D0D3D6
skinparam PackageBackgroundColor #FFFFFF
skinparam RectangleBorderColor #E5E6EB
skinparam ArrowColor #FFFFFF
hide stereotype

title Alert card in the group (schematic)

package "Lark group · interactive card" {
  rectangle "<color:#FFFFFF><b>[Grafana alert] FIRING HighP99Latency</b></color>" as hd #C4564A

  rectangle "**Service**           **Env**\napi-gateway           prod\n\n**Severity**          **Status**\nP1                    FIRING" as fields

  rectangle "**Summary**: P99 latency above threshold\n**Details**: p99 > 1s for 5 minutes" as summary

  rectangle "**Owner**: @oncall     **CC**: on-call pool\n**Started**: 2026-09-05 10:00:00     **Value**: 1.37" as meta

  rectangle "[I got this]   [Resolved]   [False alarm]   [AI attribution]   [Open dashboard]" as buttons

  rectangle "<size:11>incident #42</size>" as note #F2F3F5
}

hd -[hidden]down- fields
fields -[hidden]down- summary
summary -[hidden]down- meta
meta -[hidden]down- buttons
buttons -[hidden]down- note
@enduml
