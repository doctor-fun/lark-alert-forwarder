@startuml architecture
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName "PingFang SC"
skinparam ArrowColor #555555
skinparam RectangleBorderColor #888888
skinparam PackageBorderColor #BBBBBB
top to bottom direction

title 两条方向：告警打进来 / 飞书回打过来

together {
  rectangle "Grafana Contact Point" as Grafana
  rectangle "DataWorks 等非 Grafana 来源" as DataWorks
}

package "lark-alert-forwarder" {
  package "告警进线（外部系统 → 本服务）" {
    rectangle "POST /grafana/feishu" as IngressG
    rectangle "POST /dataworks/alert" as IngressD
    rectangle "校验 token · 按 service 选群 · 拼卡片" as Process
  }
  package "飞书事件回调（飞书 → 本服务）" {
    rectangle "POST /feishu/events\n不是告警入口\nurl_verification：开放平台握手\ncard.action.trigger：有人点了卡片" as IngressE
  }
  rectangle "Escalator（可选）\n未认领则 L1 @ / L2 电话" as Esc
}

package "飞书" {
  rectangle "OpenAPI\n本服务主动调用：发卡片 / 回线程" as OpenAPI
  rectangle "告警群" as Group
  actor "值班人" as User
}

Grafana --> IngressG
DataWorks --> IngressD
IngressG --> Process
IngressD --> Process
Process --> OpenAPI
OpenAPI --> Group

User --> Group : 点「我来处理」
Group --> IngressE : 事件订阅回打
IngressE --> OpenAPI : 回线程记下处理人

Esc ..> Group
@enduml
