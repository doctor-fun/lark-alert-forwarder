@startuml architecture-en
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName "Helvetica"
skinparam ArrowColor #555555
skinparam RectangleBorderColor #888888
skinparam PackageBorderColor #BBBBBB
top to bottom direction

title Two directions: alerts in / Lark calls back

together {
  rectangle "Grafana Contact Point" as Grafana
  rectangle "DataWorks and other non-Grafana sources" as DataWorks
}

package "lark-alert-forwarder" {
  package "Alert ingress (systems → this service)" {
    rectangle "POST /grafana/feishu" as IngressG
    rectangle "POST /dataworks/alert" as IngressD
    rectangle "Check token · pick chat · build card" as Process
  }
  package "Lark event callback (Lark → this service)" {
    rectangle "POST /feishu/events\nnot an alert ingress\nurl_verification: handshake\ncard.action.trigger: someone clicked" as IngressE
  }
  rectangle "Escalator (optional)\nL1 mention / L2 voice if unclaimed" as Esc
}

package "Lark / Feishu" {
  rectangle "OpenAPI\nwe call Lark: send card / reply" as OpenAPI
  rectangle "Alert group" as Group
  actor "On-call" as User
}

Grafana --> IngressG
DataWorks --> IngressD
IngressG --> Process
IngressD --> Process
Process --> OpenAPI
OpenAPI --> Group

User --> Group : clicks "I got this"
Group --> IngressE : event subscription callback
IngressE --> OpenAPI : reply in thread with the operator

Esc ..> Group
@enduml
